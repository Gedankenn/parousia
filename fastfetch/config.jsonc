{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "raw",
    "source": "~/.config/fastfetch/omarchy_medieval_logo.six",
    "width": 72,
    "height": 23,
    "padding": {
      "top": 0,
      "right": 3,
      "left": 0
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 16
    },
    "color": {
      "keys": "38;2;224;180;90",
      "title": "38;2;244;237;224"
    },
    "disableLinewrap": true
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;224;180;90m  ❖═══════ ☧  P A R O U S I A ═══════❖\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;244;237;224m       S E C O N D   C O M I N G\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;224;180;90m  ❖══════════════════════════════════❖\u001b[0m"
    },
    {
      "type": "title",
      "key": "  SERVUS",
      "keyColor": "38;2;224;180;90",
      "format": "{user-name} · {host-name}"
    },
    {
      "type": "custom",
      "key": "  VERBUM",
      "keyColor": "38;2;139;58;66",
      "format": "Veritas liberabit vos · Jo 8,32"
    },
    {
      "type": "custom",
      "key": "  VIA",
      "keyColor": "38;2;139;58;66",
      "format": "Ad Iesum per Mariam"
    },
    {
      "type": "command",
      "key": "  HORA",
      "keyColor": "38;2;139;58;66",
      "text": "h=$(date +%H); if [ \"$h\" -lt 5 ]; then echo Matutinum; elif [ \"$h\" -lt 6 ]; then echo Laudes; elif [ \"$h\" -lt 9 ]; then echo Prima; elif [ \"$h\" -lt 12 ]; then echo Tertia; elif [ \"$h\" -lt 15 ]; then echo Sexta; elif [ \"$h\" -lt 17 ]; then echo Nona; elif [ \"$h\" -lt 20 ]; then echo Vesperae; else echo Completorium; fi"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;224;180;90m  ◆────────  OFFICIUM  ────────◆\u001b[0m"
    },
    {
      "type": "host",
      "key": "  ◆  DOMUS",
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "cpu",
      "key": "  ◆  NUCLEUS",
      "showPeCoreCount": true,
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "gpu",
      "key": "  ◆  PICTURA",
      "hideType": "integrated",
      "format": "{name}",
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "display",
      "key": "  ◆  SPECULUM",
      "format": "{width}×{height} @ {refresh-rate} Hz",
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "disk",
      "key": "  ◆  ARCHIVUM",
      "folders": "/",
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "memory",
      "key": "  ◆  MEMORIA",
      "keyColor": "38;2;224;180;90"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;224;180;90m  ◆──────────  ORDO  ──────────◆\u001b[0m"
    },
    {
      "type": "command",
      "key": "  ◆  REGNUM",
      "keyColor": "38;2;184;168;120",
      "text": "version=$(omarchy-version) && echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "  ◆  CANALIS",
      "keyColor": "38;2;184;168;120",
      "text": "omarchy version channel"
    },
    {
      "type": "kernel",
      "key": "  ◆  LEX",
      "keyColor": "38;2;184;168;120"
    },
    {
      "type": "wm",
      "key": "  ◆  CURIA",
      "keyColor": "38;2;184;168;120"
    },
    {
      "type": "shell",
      "key": "  ◆  CONCHA",
      "keyColor": "38;2;184;168;120"
    },
    {
      "type": "terminal",
      "key": "  ◆  NAVIS",
      "keyColor": "38;2;184;168;120"
    },
    {
      "type": "packages",
      "key": "  ◆  LIBRI",
      "keyColor": "38;2;184;168;120"
    },
    {
      "type": "command",
      "key": "  ◆  MISSALE",
      "keyColor": "38;2;184;168;120",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme  \\e[38;2;255;93;115m●\\e[38;2;246;209;92m●\\e[38;2;95;224;122m●\\e[38;2;62;224;212m●\\e[38;2;91;156;255m●\\e[38;2;224;144;255m●\\e[38;2;224;180;90m●\\e[38;2;244;237;224m●\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;139;58;66m  ◆──────────  HORAE  ──────────◆\u001b[0m"
    },
    {
      "type": "command",
      "key": "  ◆  AETAS",
      "keyColor": "38;2;139;58;66",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) dies"
    },
    {
      "type": "uptime",
      "key": "  ◆  VIGILIA",
      "keyColor": "38;2;139;58;66"
    },
    {
      "type": "command",
      "key": "  ◆  RENOVATIO",
      "keyColor": "38;2;139;58;66",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;224;180;90m  ❖══════════════════════════════════❖\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;163;152;134m     Gloria in excelsis Deo\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 4
    }
  ]
}
